---
import Base from './Base.astro';
import { url, imagem } from '../lib/caminhos';
import { arvore, paginasOrdenadas, hrefPagina, type Pagina } from '../lib/biblioteca';
import { secoes } from '../data/navegacao';

interface Props {
  pagina: Pagina;
  headings: { depth: number; slug: string; text: string }[];
}
const { pagina, headings } = Astro.props;
const secoesArvore = await arvore();
const ordem = await paginasOrdenadas();
const i = ordem.findIndex((p) => p.id === pagina.id);
const anterior = ordem[i - 1];
const proxima = ordem[i + 1];
const secao = secoes.find((s) => s.chave === pagina.data.secao)!;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const img = pagina.data.imagem ? imagem(pagina.data.imagem) : null;
const og = `/og/${pagina.id.replace(/\//g, '--')}.jpg`;
---
<Base titulo={pagina.data.titulo} descricao={pagina.data.resumo} og={og}>
  <div class="biblioteca envoltorio">
    <aside class="lateral" aria-label="Seções da biblioteca">
      <details class="lateral-movel">
        <summary>{secao.nome} · índice</summary>
        <nav>
          {secoesArvore.map((s) => (
            <div class="grupo">
              <p class="grupo-titulo"><span aria-hidden="true">{s.ideograma}</span> {s.nome}</p>
              <ul>{s.paginas.map((p) => <li><a href={url(hrefPagina(p))} aria-current={p.id === pagina.id ? 'page' : undefined}>{p.data.titulo}</a></li>)}</ul>
            </div>
          ))}
        </nav>
      </details>
      <nav class="lateral-fixa">
        {secoesArvore.map((s) => (
          <details class="grupo" open={s.chave === pagina.data.secao}>
            <summary class="grupo-titulo"><span aria-hidden="true">{s.ideograma}</span> {s.nome}</summary>
            <ul>{s.paginas.map((p) => <li><a href={url(hrefPagina(p))} aria-current={p.id === pagina.id ? 'page' : undefined}>{p.data.titulo}</a></li>)}</ul>
          </details>
        ))}
      </nav>
    </aside>

    <article class="artigo" data-pagefind-body>
      <header class="cabeca-pagina">
        <span class="fantasma-ideograma" aria-hidden="true">{pagina.data.ideograma ?? secao.ideograma}</span>
        <p class="rotulo"><a href={url('/biblioteca/')}>Biblioteca</a> · {secao.nome}</p>
        <h1>{pagina.data.titulo}</h1>
        <p class="lead">{pagina.data.resumo}</p>
      </header>
      {img && (
        <figure class="figura-topo">
          <picture>
            <source media="(max-width: 700px)" srcset={img.srcMovel} />
            <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="1200" height="500" />
          </picture>
        </figure>
      )}
      {toc.length > 2 && (
        <details class="toc-movel">
          <summary>Nesta página</summary>
          <ul>{toc.map((h) => <li class={`n${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>
      )}
      <div class="prosa">
        <slot />
      </div>
      <nav class="anterior-proxima" aria-label="Navegação entre páginas">
        {anterior ? <a class="ap ap-ant" href={url(hrefPagina(anterior))} rel="prev"><span class="rotulo ouro">← Anterior</span><span>{anterior.data.titulo}</span></a> : <span />}
        {proxima && <a class="ap ap-prox" href={url(hrefPagina(proxima))} rel="next"><span class="rotulo ouro">Próxima →</span><span>{proxima.data.titulo}</span></a>}
      </nav>
    </article>

    {toc.length > 2 && (
      <nav class="toc" aria-label="Nesta página">
        <p class="rotulo ouro">Nesta página</p>
        <ul>{toc.map((h) => <li class={`n${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
  </div>
</Base>

<script>
  // o sumário marca a seção visível (tabelas largas rolam para os lados só com CSS, sem mexer no layout)
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) {
        links.forEach((l) => l.toggleAttribute('aria-current', l.hash === '#' + e.target.id));
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.prosa h2[id], .prosa h3[id]').forEach((h) => obs.observe(h));
  }
</script>

<style>
  .biblioteca { display: grid; gap: 1rem; padding-top: 1rem; }
  .lateral-fixa { display: none; }
  .lateral-movel { border: var(--borda); background: var(--tinta-2); }
  .lateral-movel summary, .toc-movel summary { padding: .8rem 1rem; font: 700 .95rem var(--f-ui); cursor: pointer; min-height: 2.75rem; }
  .lateral-movel nav { padding: 0 1rem 1rem; max-height: 60vh; overflow-y: auto; }
  .grupo { margin-bottom: .6rem; }
  .grupo-titulo { font: 700 .8rem var(--f-ui); letter-spacing: .14em; text-transform: uppercase; color: var(--papel-3); margin: .8rem 0 .3rem; cursor: pointer; list-style: none; }
  .grupo-titulo span { font: 400 1.05rem var(--f-display); color: var(--sangue-texto); letter-spacing: 0; margin-right: .3rem; }
  .grupo ul { list-style: none; margin: 0; padding: 0 0 0 .2rem; border-left: 1px solid var(--linha); }
  .grupo a { display: block; padding: .38rem .8rem; font: 500 .98rem/1.3 var(--f-ui); color: var(--papel-2); text-decoration: none; margin-left: -1px; border-left: 2px solid transparent; }
  .grupo a:hover { color: var(--papel); }
  .grupo a[aria-current='page'] { color: var(--papel); border-left-color: var(--sangue-vivo); background: linear-gradient(90deg, rgba(168,18,26,.12), transparent); }
  .artigo { min-width: 0; }
  .artigo .cabeca-pagina { overflow: hidden; }
  .artigo .cabeca-pagina a { color: inherit; text-decoration: none; }
  .figura-topo { margin: 0 0 2rem; }
  .figura-topo img { width: 100%; height: clamp(10rem, 30vw, 18rem); object-fit: cover; filter: grayscale(.4) brightness(.75) sepia(.3); clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%); }
  .toc-movel { border: var(--borda); margin-bottom: 1.6rem; }
  .toc-movel ul, .toc ul { list-style: none; margin: 0; padding: 0 1rem 1rem; }
  .toc ul { padding: 0; }
  .toc li.n3, .toc-movel li.n3 { padding-left: .9rem; }
  .toc a, .toc-movel a { display: block; padding: .3rem 0; font: .92rem/1.35 var(--f-ui); color: var(--papel-3); text-decoration: none; }
  .toc a:hover, .toc a[aria-current] { color: var(--papel); }
  .toc a[aria-current] { box-shadow: -2px 0 0 var(--sangue-vivo); padding-left: .6rem; }
  .toc { display: none; }
  .anterior-proxima { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; border-top: 1px solid var(--linha); padding-top: 1.5rem; }
  .ap { display: grid; gap: .3rem; padding: 1rem; border: var(--borda); text-decoration: none; font: 1.1rem var(--f-display); min-height: 2.75rem; }
  .ap:hover { border-color: var(--sangue); color: var(--papel); }
  .ap-prox { text-align: right; grid-column: 2; }
  @media (min-width: 1000px) {
    .biblioteca { grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; }
    .lateral-movel { display: none; }
    .lateral-fixa { display: block; position: sticky; top: calc(var(--topo) + 1rem); max-height: calc(100vh - var(--topo) - 2rem); overflow-y: auto; padding-right: .5rem; scrollbar-width: thin; }
    .toc-movel { display: none; }
  }
  @media (min-width: 1280px) {
    .biblioteca { grid-template-columns: 15rem minmax(0, 1fr) 13rem; }
    .toc { display: block; position: sticky; top: calc(var(--topo) + 2rem); align-self: start; max-height: calc(100vh - var(--topo) - 3rem); overflow-y: auto; }
  }
</style>
