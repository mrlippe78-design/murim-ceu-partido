---
import Base from '../layouts/Base.astro';
import { url } from '../lib/caminhos';
const perguntas = [
  { id: 'q1', p: 'Quantos pontos de atributo você distribui na criação?', o: [['a', '4.000'], ['b', '5.000'], ['c', '6.000']] },
  { id: 'q2', p: 'Na rolagem de gargalo (3d6 + modificadores), com que total você avança de reino?', o: [['a', '8 ou mais'], ['b', '10 ou mais'], ['c', '12 ou mais']] },
  { id: 'q3', p: 'Você ataca um NPC. Quem decide se o golpe acertou e quanto machucou?', o: [['a', 'As regras e o narrador'], ['b', 'Eu, ao escrever a cena'], ['c', 'O jogador com mais Fama']] },
  { id: 'q4', p: 'Quantos treinos seu personagem pode enviar por semana?', o: [['a', '1'], ['b', '2'], ['c', '3']] },
  { id: 'q5', p: 'Uma Leitura do Destino pode ser refeita?', o: [['a', 'Sim, uma vez por personagem'], ['b', 'Não, nunca'], ['c', 'Sim, pagando taéis']] },
  { id: 'q6', p: 'Seus dois personagens podem trocar itens ou dinheiro?', o: [['a', 'Não'], ['b', 'Sim'], ['c', 'Só taéis']] },
];
const passos = [
  { t: 'O mundo', i: '界', x: 'Ano 31 após a Guerra do Eclipse. A Aliança Marcial venceu o Culto da Lua de Sangue, mas apodreceu. O Culto disputa um trono vazio, a Corte paga as facções para se matarem e as lanternas vermelhas voltaram a acender no oeste.', l: '/biblioteca/mundo/planicies-centrais/' },
  { t: 'Seu personagem', i: '人', x: 'Você começa na Terceira Classe, com 5.000 pontos de atributo (mín. 500, máx. 1.600 cada), 1.000 de Qi, uma Arte Interna e 3 técnicas Básicas. Escolhe linhagem, origem, facção, seita e talentos, com pelo menos 1 desvantagem.', l: '/biblioteca/personagem/criacao/' },
  { t: 'O destino', i: '命', x: 'Uma Leitura do Destino sorteia, no servidor, seu Corpo Marcial, Raiz de Qi ou Linhagem rara. Quase todos tiram Corpo Mortal. Um Mítico sai uma vez em duas mil leituras. Ninguém pode refazer.', l: '/biblioteca/personagem/leitura-do-destino/' },
  { t: 'Cultivo', i: '氣', x: 'Treinos (3 por semana, 20+ linhas) e missões (2 por semana) dão PE. O estágio sobe sozinho; para mudar de reino, você envia um texto de 40+ linhas e rola 3d6 no servidor: 12+ avança, 7 ou menos é Desvio de Qi.', l: '/biblioteca/cultivo/reinos/' },
  { t: 'Combate e convivência', i: '劍', x: 'Ataque = atributo + técnica + arma, contra a defesa do outro, com um ciclo de vantagens. Você narra só o seu personagem: o resultado sobre os outros é das regras e do narrador. Combate é não letal, a menos que a cena seja marcada como Letal.', l: '/biblioteca/combate/regras-de-combate/' },
];
---
<Base titulo="Primeira vez aqui?" descricao="Tutorial de 5 minutos com as regras essenciais e um quiz rápido que libera a criação de ficha.">
  <div class="estreito pagina">
    <header class="cabeca-pagina">
      <span class="fantasma-ideograma" aria-hidden="true">學</span>
      <p class="rotulo">Cinco minutos</p>
      <h1>Primeira vez aqui?</h1>
      <p class="lead">Cinco pergaminhos curtos e seis perguntas. Acertando cinco, a criação de ficha fica liberada na sua conta.</p>
    </header>
    <ol class="pergaminhos">
      {passos.map((p, i) => (
        <li><span class="pi" aria-hidden="true">{p.i}</span><div><h2>{i + 1}. {p.t}</h2><p>{p.x}</p><a href={url(p.l)}>Ler a regra completa</a></div></li>
      ))}
    </ol>
    <form id="quiz" class="painel">
      <h2 style="margin-top:0">Quiz</h2>
      {perguntas.map((q) => (
        <fieldset class="pergunta"><legend>{q.p}</legend>
          {q.o.map(([v, t]) => <label class="resposta"><input type="radio" name={q.id} value={v} required /> {t}</label>)}
        </fieldset>
      ))}
      <button class="btn" type="submit">Conferir respostas</button>
      <div id="resultado" aria-live="polite"></div>
    </form>
  </div>
</Base>
<script>
  import { supabase, sessao, link, toast } from '../scripts/app';
  document.getElementById('quiz')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const respostas = Object.fromEntries(['q1', 'q2', 'q3', 'q4', 'q5', 'q6'].map((k) => [k, fd.get(k)]));
    const saida = document.getElementById('resultado')!;
    if (!(await sessao())) {
      saida.innerHTML = `<p class="nota">Para registrar o resultado e liberar sua ficha, <a href="${link('/conta/?criar=1&voltar=' + encodeURIComponent(location.pathname))}">crie uma conta ou entre</a> e responda de novo.</p>`;
      return;
    }
    const { data, error } = await supabase.rpc('aprovar_quiz', { p_respostas: respostas });
    if (error) return toast(error.message, true);
    saida.innerHTML = data.aprovado
      ? `<p class="ok"><strong>${data.acertos} de ${data.total}.</strong> Bem-vindo ao Jianghu. A criação de ficha está liberada.</p><a class="btn" href="${link('/conta/')}">Criar minha ficha</a>`
      : `<p class="erro"><strong>${data.acertos} de ${data.total}.</strong> Releia os pergaminhos e tente de novo (precisa de 5).</p>`;
  });
</script>
<style>
  .pergaminhos { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; gap: 1.5rem; }
  .pergaminhos li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--linha); }
  .pi { font: 400 2.8rem/1 var(--f-display); color: var(--sangue-vivo); }
  .pergaminhos h2 { margin: 0 0 .4rem; font-size: 1.4rem; }
  .pergunta { border: 0; padding: 0; margin: 0 0 1.4rem; }
  .pergunta legend { font: 400 1.15rem var(--f-display); margin-bottom: .5rem; }
  .resposta { display: flex; gap: .6rem; align-items: center; padding: .55rem .7rem; border: var(--borda); margin-bottom: .35rem; color: var(--papel); cursor: pointer; min-height: 2.9rem; }
  .resposta:has(input:checked) { border-color: var(--sangue-vivo); }
  #resultado { margin-top: 1.2rem; }
</style>
