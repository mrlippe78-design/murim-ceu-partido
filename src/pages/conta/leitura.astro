---
import Base from '../../layouts/Base.astro';
import { imagem } from '../../lib/caminhos';
const fundo = imagem('leitura');
---
<Base titulo="Leitura do Destino" noindex classe="leitura">
  <section class="altar" id="altar" aria-labelledby="titulo-leitura">
    <img class="altar-fundo" src={fundo.srcMovel} alt="" aria-hidden="true" loading="eager" decoding="async" />
    <div class="ceu" id="ceu" aria-hidden="true"></div>
    <svg class="raios" id="raios" viewBox="0 0 400 800" preserveAspectRatio="none" aria-hidden="true">
      <path d="M220 0 L180 180 L230 190 L150 420 L200 425 L120 800" />
      <path d="M90 0 L120 140 L80 150 L130 330" />
      <path d="M330 0 L300 220 L340 230 L280 520" />
    </svg>
    <div class="altar-conteudo envoltorio">
      <p class="rotulo ouro" id="nome-alvo">…</p>
      <h1 id="titulo-leitura">Leitura do Destino</h1>
      <p class="mudo intro">O céu escreveu algo sobre você antes de você nascer. Escolha o que ler. Não há como desfazer.</p>

      <div class="estado-leituras">
        <span>Leituras: <strong class="numero" id="qtd">—</strong></span>
        <span class="fios">Fios do Destino <span class="barra-fios"><span id="barra-fios"></span></span> <strong class="numero" id="fios">0</strong>/40</span>
      </div>

      <div class="escolhas" id="escolhas" role="group" aria-label="O que ler">
        <button class="rolo" data-tipo="corpo"><span class="rolo-ideograma" aria-hidden="true">體</span><span class="rolo-nome">Corpo Marcial</span><span class="rolo-det">Comum 89,55% · Raro 8% · Épico 2% · Lendário 0,4% · Mítico 0,05%</span></button>
        <button class="rolo" data-tipo="raiz"><span class="rolo-ideograma" aria-hidden="true">根</span><span class="rolo-nome">Raiz de Qi</span><span class="rolo-det">Comum 80% · Dupla 15% · Pura 4% · Variante 1%</span></button>
        <button class="rolo" data-tipo="linhagem"><span class="rolo-ideograma" aria-hidden="true">血</span><span class="rolo-nome">Linhagem rara</span><span class="rolo-det">Nenhuma 96% · Besta Espiritual 2% · Espírito da Montanha 2%</span></button>
      </div>
      <p class="aviso-sem" id="sem-leituras" hidden></p>

      <div class="pergaminho" id="pergaminho" hidden aria-live="assertive">
        <div class="papel">
          <p class="p-tipo" id="p-tipo"></p>
          <p class="p-raridade" id="p-raridade"></p>
          <h2 class="p-nome" id="p-nome"></h2>
          <div class="p-det" id="p-det"></div>
          <span class="carimbo" id="carimbo" aria-hidden="true">命</span>
        </div>
        <div class="pos-leitura" id="pos-leitura"></div>
      </div>
      <a class="voltar" id="voltar" href="#">← Voltar à ficha</a>
    </div>
  </section>
  <dialog id="confirmar" class="confirmar">
    <form method="dialog">
      <p class="rotulo">Última chance</p>
      <h2 id="confirmar-titulo">Ler o Corpo Marcial?</h2>
      <p>A Leitura é feita no servidor, registrada para sempre e não pode ser refeita nem apagada.</p>
      <div class="linha-flex"><button class="btn" value="sim">Ler o destino</button><button class="btn fantasma" value="nao">Ainda não</button></div>
    </form>
  </dialog>
</Base>

<script>
  import { iniciarLeitura } from '../../scripts/leitura';
  iniciarLeitura();
</script>

<style>
  .altar { position: relative; isolation: isolate; min-height: calc(100svh - var(--topo)); padding: 3rem 0 4rem; overflow: hidden; }
  .altar-fundo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; filter: grayscale(.7) brightness(.3) sepia(.4); }
  .ceu { position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse at 50% 0%, rgba(168,18,26,.25), transparent 60%), linear-gradient(180deg, rgba(12,10,9,.4), var(--tinta)); transition: background 2.5s, opacity 2.5s; }
  .altar.escuro .ceu { background: radial-gradient(ellipse at 50% 30%, rgba(255,40,30,.35), #000 70%); }
  .altar.tremer { animation: tremor .5s 3; }
  @keyframes tremor { 25% { transform: translate(-4px, 2px); } 50% { transform: translate(3px, -3px); } 75% { transform: translate(-2px, -1px); } }
  .raios { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0; pointer-events: none; }
  .raios path { fill: none; stroke: #fff6e0; stroke-width: 3; filter: drop-shadow(0 0 12px #ffd27a); }
  .altar.relampago .raios { animation: relampago 1.6s steps(1) 2; }
  .altar.relampago::after { content: ''; position: absolute; inset: 0; background: #fff; z-index: 0; pointer-events: none; animation: flash 1.6s 2; opacity: 0; }
  @keyframes relampago { 0%, 18%, 40%, 100% { opacity: 0; } 8%, 28% { opacity: 1; } }
  @keyframes flash { 0%, 100% { opacity: 0; } 7% { opacity: .55; } 12% { opacity: 0; } 27% { opacity: .3; } 31% { opacity: 0; } }
  .altar-conteudo { position: relative; text-align: center; }
  .intro { max-width: 34rem; margin-inline: auto; }
  .estado-leituras { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; font: 1rem var(--f-ui); margin: 1.5rem 0 2rem; }
  .barra-fios { display: inline-block; width: 6rem; height: .45rem; background: var(--tinta-4); vertical-align: middle; position: relative; margin: 0 .3rem; }
  .barra-fios span { position: absolute; inset: 0 auto 0 0; background: var(--ouro); }
  .escolhas { display: grid; gap: 1rem; max-width: 60rem; margin: 0 auto; }
  @media (min-width: 800px) { .escolhas { grid-template-columns: repeat(3, 1fr); } }
  .rolo { position: relative; display: grid; gap: .4rem; justify-items: center; padding: 2rem 1.2rem 1.6rem; background: linear-gradient(180deg, #1b1411, #120d0b); border: 1px solid var(--linha); border-top: 6px solid #3a2a1c; border-bottom: 6px solid #3a2a1c; color: var(--papel); cursor: pointer; transition: transform var(--rapido), border-color var(--rapido); }
  .rolo:hover:not(:disabled), .rolo:focus-visible { transform: translateY(-4px); border-color: var(--sangue-vivo); }
  .rolo:disabled { opacity: .4; cursor: not-allowed; }
  .rolo-ideograma { font: 400 3.6rem/1 var(--f-display); color: var(--sangue-texto); }
  .rolo-nome { font: 400 1.5rem var(--f-display); }
  .rolo-det { font: .82rem/1.4 var(--f-ui); color: var(--papel-3); }
  .aviso-sem { margin-top: 1.5rem; color: var(--papel-2); }
  .pergaminho { max-width: 34rem; margin: 0 auto; }
  .papel { position: relative; background: #e9dcc0; color: #1d1410; padding: 2.4rem 1.8rem 2.8rem; transform-origin: top center; box-shadow: 0 0 0 1px #b9a27a, 0 30px 80px -20px rgba(0,0,0,.8); background-image: radial-gradient(circle at 20% 10%, rgba(120,80,40,.15), transparent 40%), radial-gradient(circle at 80% 90%, rgba(120,20,20,.12), transparent 40%); }
  .papel::before, .papel::after { content: ''; position: absolute; left: -.8rem; right: -.8rem; height: 1rem; background: #3a2a1c; border-radius: 6px; }
  .papel::before { top: -.5rem; } .papel::after { bottom: -.5rem; }
  .pergaminho.abrir .papel { animation: desenrolar 1.3s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes desenrolar { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  .p-tipo { font: 700 .8rem var(--f-ui); letter-spacing: .3em; text-transform: uppercase; color: #6b4b2a; margin: 0; }
  .p-raridade { font: 700 .95rem var(--f-ui); letter-spacing: .35em; text-transform: uppercase; margin: 1rem 0 .2rem; color: var(--r, #6b4b2a); filter: brightness(.7); }
  .p-nome { font: 400 clamp(2rem, 7vw, 3rem)/1.05 var(--f-display); margin: .2rem 0 1rem; color: #1d1410; }
  .p-det { font: 1rem/1.5 var(--f-texto); color: #3b2a20; text-align: left; }
  .p-det strong { color: #1d1410; }
  .tinta { opacity: 0; filter: blur(6px); transition: opacity 1.2s, filter 1.2s; }
  .tinta.ver { opacity: 1; filter: none; }
  .carimbo { position: absolute; right: 1.2rem; bottom: 1.2rem; display: grid; place-items: center; width: 4.2rem; height: 4.2rem; background: #a8121a; color: #f4e4d0; font: 400 2.4rem/1 var(--f-display); transform: rotate(-8deg) scale(0); opacity: 0; box-shadow: inset 0 0 0 3px #7a0a10; }
  .carimbo.bater { animation: carimbar .45s cubic-bezier(.3,1.6,.5,1) forwards; }
  @keyframes carimbar { 0% { transform: rotate(-8deg) scale(2.6); opacity: 0; } 60% { opacity: 1; } 100% { transform: rotate(-8deg) scale(1); opacity: 1; } }
  .r-lendario .papel { box-shadow: 0 0 0 2px #e0ac45, 0 0 60px rgba(224,172,69,.55), 0 30px 80px -20px rgba(0,0,0,.8); }
  .r-mitico .papel { box-shadow: 0 0 0 2px #ff5a4a, 0 0 90px rgba(255,60,40,.7), 0 30px 80px -20px rgba(0,0,0,.8); }
  .pos-leitura { margin-top: 2rem; display: grid; gap: 1rem; justify-items: center; }
  .voltar { display: inline-block; margin-top: 2.5rem; color: var(--papel-2); padding: .6rem; }
  .confirmar { background: var(--tinta-2); color: var(--papel); border: 1px solid var(--sangue); padding: 2rem; max-width: 26rem; }
  .confirmar::backdrop { background: rgba(0,0,0,.75); }
  @media (prefers-reduced-motion: reduce) { .altar.relampago .raios, .altar.relampago::after, .altar.tremer { animation: none; } }
</style>
