---
import Base from '../layouts/Base.astro';
import { url, imagem } from '../lib/caminhos';
import site from '../data/site.json';
import dados from '../../supabase/functions/_shared/dados.json';

const hero = imagem('hero');
const faixa = imagem('convite-faixa');
const pitch: Record<string, string> = {
  alianca: 'Venceram a guerra. Perderam a alma. Hoje vendem justiça a quem paga o dízimo.',
  clas_nobres: 'Sangue antigo, terras largas e rancores que atravessam gerações.',
  heterodoxa: 'Piratas de rio, envenenadores, assassinos sem rosto. Nenhuma regra, só preços.',
  culto: 'Quatro herdeiros disputam um trono vazio. A lua já começou a sangrar de novo.',
  corte: 'O Imperador paga para as facções se matarem. A Guarda do Dragão Negro anota quem sobra.',
};
const trailer = [
  { ano: 'Ano 0', texto: 'A lua ficou vermelha por quarenta noites.' },
  { ano: '', texto: 'Metade dos grandes mestres não voltou para casa.' },
  { ano: '', texto: 'A Espada Sem Nome caiu num duelo que ninguém viu.' },
  { ano: '', texto: 'O Soberano de Sangue desapareceu. Sem corpo. Sem túmulo.' },
  { ano: 'Ano 28', texto: 'Uma cidade inteira bebeu do poço errado.' },
  { ano: 'Ano 31', texto: 'As lanternas vermelhas voltaram a acender no oeste.' },
  { ano: '', texto: 'E você acabou de chegar.', destaque: true },
];
const rumores = [
  'Dizem que manuais da Espada Sem Nome foram vistos numa caravana rumo ao norte.',
  'Três discípulos da Montanha Celeste acordaram sem Qi. Os médicos não sabem por quê.',
  'A Agência Trovão do Norte perdeu outra carga. Ninguém assinou o ataque.',
  'Um mendigo no Coração Imperial jura ter visto o Soberano de Sangue rindo numa casa de chá.',
  'O Vale dos Cem Venenos está comprando ervas raras. Em quantidade.',
];
---
<Base classe="convite" descricao={`${site.frase} ${site.convite}`}>
  <section class="hero" aria-labelledby="titulo-hero">
    <picture class="hero-arte">
      <source media="(max-width: 700px)" srcset={hero.srcMovel} />
      <img src={hero.src} alt={hero.alt} width="1100" height="1920" fetchpriority="high" decoding="async" />
    </picture>
    <span class="hero-ideograma" aria-hidden="true">武</span>
    <canvas class="cinzas" aria-hidden="true"></canvas>
    <div class="hero-vertical" aria-hidden="true">天裂之後 · 三十一年</div>
    <div class="hero-texto">
      <p class="rotulo ouro hero-ano">Planícies Centrais · Ano {site.ano} após a Guerra do Eclipse</p>
      <h1 id="titulo-hero">
        <span class="t-murim">Murim</span>
        <span class="t-ceu">Céu <em>Partido</em></span>
      </h1>
      <svg class="golpe" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
        <path d="M2 34 L598 4" />
      </svg>
      <p class="hero-frase">{site.frase}</p>
      <p class="hero-sub">{site.convite}</p>
      <div class="linha-flex hero-botoes">
        <a class="btn" href={url('/como-entrar/')}>Entrar no Jianghu</a>
        <a class="btn fantasma" href={url('/biblioteca/')}>Ler as regras</a>
      </div>
    </div>
    <a class="rolar" href="#trailer" aria-label="Continuar lendo"><span></span></a>
  </section>

  <section id="trailer" class="trailer" aria-label="O que aconteceu">
    <ol class="envoltorio">
      {trailer.map((t, i) => (
        <li class:list={['quadro', { destaque: t.destaque }]} style={`--i:${i}`}>
          {t.ano && <span class="quadro-ano">{t.ano}</span>}
          <p>{t.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="faccoes" aria-labelledby="titulo-faccoes">
    <div class="envoltorio">
      <header class="faccoes-cabeca">
        <p class="rotulo">Cinco poderes, nenhuma paz</p>
        <h2 id="titulo-faccoes">Escolha de quem você vai ter medo.</h2>
      </header>
      <ul class="lista-faccoes">
        {dados.faccoes.map((f, i) => (
          <li class="faccao" style={`--i:${i}`}>
            <span class="faccao-ideograma" aria-hidden="true">{f.ideograma}</span>
            <div class="faccao-corpo">
              <h3><a href={url(`/biblioteca/faccoes/${f.chave.replace('_', '-')}/`)}>{f.nome}</a></h3>
              <p>{pitch[f.chave]}</p>
              <p class="faccao-seitas">{f.seitas.map((s) => s.nome).join(' · ')}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="destino" aria-labelledby="titulo-destino">
    <div class="envoltorio destino-grade">
      <div class="destino-numero" aria-hidden="true">
        <span>1</span><small>em</small><span>2.000</span>
      </div>
      <div>
        <p class="rotulo">Leitura do Destino</p>
        <h2 id="titulo-destino">Você não escolhe com que corpo nasceu.</h2>
        <p>Cada personagem recebe uma Leitura, sorteada no servidor e gravada para sempre. Quase todos nascem com um Corpo Mortal, e o esforço é tudo o que têm. Um em cinquenta desperta algo Épico. Um em dois mil carrega um corpo Mítico, e o grupo inteiro vai saber no mesmo minuto.</p>
        <ul class="destino-tabela">
          {[['Comum', '89,55%', 'comum'], ['Raro', '8%', 'raro'], ['Épico', '2%', 'epico'], ['Lendário', '0,4%', 'lendario'], ['Mítico', '0,05%', 'mitico']].map(([n, p, r]) => (
            <li class={`r-${r}`}><span class="raridade">{n}</span><span class="numero">{p}</span></li>
          ))}
        </ul>
        <a class="btn fantasma" href={url('/biblioteca/personagem/leitura-do-destino/')}>Como funciona a Leitura</a>
      </div>
    </div>
  </section>

  <section class="sistemas-destaque" aria-labelledby="titulo-sistemas">
    <div class="envoltorio">
      <h2 id="titulo-sistemas" class="sr">O que você vai fazer</h2>
      <ol class="pilares">
        <li><span class="pilar-n">壹</span><h3>Cultive</h3><p>Treinos narrados viram PE. Seis reinos, três estágios cada, e um gargalo entre eles que pode rachar seu dantian.</p></li>
        <li><span class="pilar-n">貳</span><h3>Lute</h3><p>Combate por turnos com ciclo de vantagens, estados de ferimento e cenas Letais que podem matar de verdade.</p></li>
        <li><span class="pilar-n">參</span><h3>Escolha um lado</h3><p>Dezenove seitas, cada uma com uma vantagem e uma obrigação. Trair custa caro. Ficar neutro também.</p></li>
        <li><span class="pilar-n">肆</span><h3>Deixe um nome</h3><p>Fama dá alcunha, convites e cartazes com o seu rosto. Infâmia também.</p></li>
      </ol>
    </div>
  </section>

  <section class="rumores" aria-label="Rumores da taverna">
    <p class="rotulo ouro envoltorio">Ouvido na taverna</p>
    <div class="rumores-trilho">
      <ul>
        {[...rumores, ...rumores].map((r, i) => <li aria-hidden={i >= rumores.length ? 'true' : undefined}>“{r}”</li>)}
      </ul>
    </div>
  </section>

  <section class="final" aria-labelledby="titulo-final">
    <picture class="final-arte">
      <source media="(max-width: 700px)" srcset={faixa.srcMovel} />
      <img src={faixa.src} alt={faixa.alt} loading="lazy" decoding="async" width="1600" height="900" />
    </picture>
    <div class="envoltorio final-texto">
      <h2 id="titulo-final">O Jianghu não espera ninguém.</h2>
      <p>Entre no grupo, leia o básico em cinco minutos e escreva a primeira linha da sua lenda.</p>
      <div class="linha-flex">
        <a class="btn" href={url('/como-entrar/')}>Entrar no Jianghu</a>
        <a class="btn fantasma" href={url('/tutorial/')}>Primeira vez aqui?</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { iniciarConvite } from '../scripts/convite';
  iniciarConvite();
</script>

<style>
  /* ───────── HERO ───────── */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - var(--topo));
    display: grid; align-items: end;
    padding: 6rem 1.25rem 4.5rem;
  }
  .hero-arte { position: absolute; inset: 0; z-index: -3; }
  .hero-arte img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    filter: grayscale(.55) contrast(1.2) brightness(.72) sepia(.4);
    animation: respirar 18s ease-in-out infinite alternate;
  }
  .hero::before { /* nanquim escorrendo sobre a pintura */
    content: ''; position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(120% 70% at 75% 15%, transparent 0 30%, rgba(12,10,9,.55) 60%),
      linear-gradient(180deg, rgba(12,10,9,.2) 0%, rgba(12,10,9,.35) 45%, var(--tinta) 96%),
      linear-gradient(90deg, rgba(12,10,9,.8) 0%, rgba(12,10,9,.05) 75%);
  }
  .hero::after { /* véu vermelho no céu */
    content: ''; position: absolute; inset: 0 0 50% 0; z-index: -2;
    background: radial-gradient(60% 80% at 70% 0%, rgba(168,18,26,.35), transparent 70%);
    mix-blend-mode: screen;
  }
  @keyframes respirar { to { transform: scale(1.06) translateY(-1.5%); } }
  .hero-ideograma {
    position: absolute; z-index: -1; left: -.18em; bottom: -.12em;
    font: 400 clamp(19rem, 72vw, 46rem)/.8 var(--f-display);
    color: var(--sangue); opacity: .2; pointer-events: none; user-select: none;
  }
  .cinzas { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  .hero-vertical {
    position: absolute; top: 2rem; right: 1rem; writing-mode: vertical-rl;
    font: 400 1rem/1 var(--f-display); letter-spacing: .5em; color: var(--ouro); opacity: .85;
  }
  .hero-texto { max-width: 46rem; }
  .hero-ano { margin-bottom: 1rem; }
  h1 { margin: 0; line-height: .86; }
  .t-murim { display: block; font-size: clamp(4.2rem, 21vw, 11rem); letter-spacing: -.01em; color: #f5ead6; text-shadow: 0 2px 0 rgba(0,0,0,.4); }
  .t-ceu { display: block; font-size: clamp(2rem, 9vw, 4.6rem); color: var(--papel-2); margin-top: .25em; padding-left: .08em; }
  .t-ceu em { font-style: normal; color: var(--sangue-texto); }
  .golpe { width: min(100%, 34rem); height: 1.6rem; margin: .6rem 0 1.2rem; overflow: visible; }
  .golpe path { fill: none; stroke: var(--sangue-vivo); stroke-width: 3; stroke-linecap: square; stroke-dasharray: 620; stroke-dashoffset: 620; animation: cortar .9s .5s cubic-bezier(.7,0,.2,1) forwards; filter: drop-shadow(0 0 6px rgba(211,38,44,.7)); }
  @keyframes cortar { to { stroke-dashoffset: 0; } }
  .hero-frase { font: italic 400 clamp(1.25rem, 3.6vw, 1.7rem)/1.35 var(--f-texto); color: var(--papel); max-width: 30ch; margin-bottom: .6rem; }
  .hero-sub { font: 500 1.05rem var(--f-ui); color: var(--papel-2); margin-bottom: 1.8rem; }
  .hero-botoes .btn { min-width: 12rem; }
  .rolar { position: absolute; left: 50%; bottom: 1rem; width: 2.75rem; height: 2.75rem; transform: translateX(-50%); display: grid; place-items: center; }
  .rolar span { width: 1px; height: 2rem; background: linear-gradient(var(--sangue-vivo), transparent); animation: gotejar 2.2s ease-in-out infinite; }
  @keyframes gotejar { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (min-width: 900px) {
    .hero { padding: 6rem 4rem 6rem; align-items: center; }
    .hero-arte { left: 38%; }
    .hero-arte img { object-position: 50% 30%; }
    .hero-vertical { right: 2.5rem; top: 3rem; font-size: 1.15rem; }
  }

  /* ───────── TRAILER ───────── */
  .trailer { padding: 5rem 0 6rem; position: relative; }
  .trailer ol { list-style: none; padding: 0; margin: 0 auto; display: grid; gap: 3.2rem; }
  .quadro { max-width: 34rem; opacity: 0; transform: translateY(24px); transition: opacity var(--lento), transform var(--lento); }
  .quadro.visivel { opacity: 1; transform: none; }
  .quadro:nth-child(even) { justify-self: end; text-align: right; }
  .quadro p { font: 400 clamp(1.5rem, 5vw, 2.4rem)/1.2 var(--f-display); margin: 0; }
  .quadro-ano { display: block; font: 700 .8rem var(--f-ui); letter-spacing: .3em; text-transform: uppercase; color: var(--ouro); margin-bottom: .6rem; }
  .quadro.destaque { justify-self: center; text-align: center; max-width: none; padding-top: 2rem; }
  .quadro.destaque p { color: var(--sangue-texto); font-size: clamp(2rem, 7vw, 3.6rem); }

  /* ───────── FACÇÕES ───────── */
  .faccoes { padding: 3rem 0 5rem; }
  .faccoes-cabeca { max-width: 36rem; margin-bottom: 2.5rem; }
  .faccoes-cabeca h2 { margin-top: .4rem; }
  .lista-faccoes { list-style: none; margin: 0; padding: 0; }
  .faccao {
    position: relative; display: grid; grid-template-columns: 4.2rem 1fr; gap: 1.2rem; align-items: start;
    padding: 1.8rem 0; border-top: 1px solid var(--linha);
  }
  .faccao:last-child { border-bottom: 1px solid var(--linha); }
  .faccao-ideograma { font: 400 3.6rem/1 var(--f-display); color: var(--sangue-vivo); transition: transform var(--lento), color var(--rapido); }
  .faccao:hover .faccao-ideograma { transform: rotate(-8deg) scale(1.08); color: var(--sangue-texto); }
  .faccao h3 { margin: 0 0 .4rem; font-size: clamp(1.5rem, 4vw, 2.1rem); }
  .faccao h3 a { text-decoration: none; }
  .faccao h3 a::after { content: ''; position: absolute; inset: 0; }
  .faccao p { margin: 0 0 .5rem; color: var(--papel-2); max-width: 52ch; }
  .faccao-seitas { font: 500 .9rem var(--f-ui); color: var(--papel-3) !important; letter-spacing: .02em; }
  @media (min-width: 900px) {
    .faccao { grid-template-columns: 7rem 1fr; padding: 2.2rem 0; }
    .faccao:nth-child(odd) { margin-right: 14%; }
    .faccao:nth-child(even) { margin-left: 14%; }
    .faccao-ideograma { font-size: 5.5rem; }
  }

  /* ───────── DESTINO ───────── */
  .destino { padding: 5rem 0; background: linear-gradient(180deg, transparent, #120a09 30%, #120a09 70%, transparent); }
  .destino-grade { display: grid; gap: 2.5rem; align-items: center; }
  .destino-numero { display: grid; justify-items: start; font: 400 clamp(4.5rem, 20vw, 10rem)/.9 var(--f-display); color: var(--r-mitico); }
  .destino-numero small { font: 700 1rem var(--f-ui); letter-spacing: .4em; text-transform: uppercase; color: var(--papel-3); margin: .4rem 0 .4rem .4rem; }
  .destino-numero span:last-child { color: var(--papel); }
  .destino-tabela { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: .1rem; max-width: 26rem; }
  .destino-tabela li { display: flex; justify-content: space-between; padding: .55rem .2rem; border-bottom: 1px dashed var(--linha); }
  .destino-tabela .numero { color: var(--r); }
  @media (min-width: 900px) { .destino-grade { grid-template-columns: .8fr 1.2fr; } }

  /* ───────── PILARES ───────── */
  .sistemas-destaque { padding: 4rem 0; }
  .pilares { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.4rem; counter-reset: p; }
  .pilares li { position: relative; padding-left: 3.6rem; }
  .pilar-n { position: absolute; left: 0; top: -.2rem; font: 400 2.4rem/1 var(--f-display); color: var(--ouro); }
  .pilares h3 { margin: 0 0 .4rem; }
  .pilares p { color: var(--papel-2); margin: 0; }
  @media (min-width: 760px) { .pilares { grid-template-columns: 1fr 1fr; column-gap: 4rem; } .pilares li:nth-child(even) { margin-top: 3rem; } }

  /* ───────── RUMORES ───────── */
  .rumores { padding: 3rem 0; border-block: 1px solid var(--linha); background: var(--tinta-2); overflow: hidden; }
  .rumores-trilho ul { display: flex; gap: 3rem; list-style: none; margin: 1rem 0 0; padding: 0; width: max-content; animation: deslizar 70s linear infinite; }
  .rumores-trilho li { font: italic 1.2rem var(--f-texto); color: var(--papel-2); white-space: nowrap; }
  .rumores:hover ul { animation-play-state: paused; }
  @keyframes deslizar { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .rumores-trilho ul { flex-direction: column; width: auto; padding-inline: 1.25rem; gap: 1rem; }
    .rumores-trilho li { white-space: normal; }
    .rumores-trilho li[aria-hidden] { display: none; }
    .quadro { opacity: 1; transform: none; }
    .hero-arte img { animation: none; }
  }

  /* ───────── FINAL ───────── */
  .final { position: relative; isolation: isolate; padding: 8rem 0 6rem; overflow: hidden; clip-path: polygon(0 6%, 100% 0, 100% 100%, 0 100%); margin-top: 3rem; }
  .final-arte { position: absolute; inset: 0; z-index: -2; }
  .final-arte img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.5) brightness(.45) sepia(.4); }
  .final::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(12,10,9,.92), rgba(12,10,9,.4)); }
  .final-texto { max-width: 40rem; margin-left: max(1.25rem, calc((100% - 76rem) / 2)); }
  .final-texto p { color: var(--papel-2); font-size: 1.2rem; margin-bottom: 1.8rem; }
</style>
